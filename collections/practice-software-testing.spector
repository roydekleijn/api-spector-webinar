  "requests": {
    "31cd450f-fbf6-4fa1-8a2b-ac030e96d064": {
      "id": "31cd450f-fbf6-4fa1-8a2b-ac030e96d064",
      "name": "Health check",
      "method": "GET",
      "url": "{{base_url}}/status",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "none"
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.test('version equals \"5.0\"', function() {\n  sp.expect(json.version).to.equal(\"5.0\");\n});"
    },
    "d4539f08-4cf4-4b48-8a73-6431551ca4af": {
      "id": "d4539f08-4cf4-4b48-8a73-6431551ca4af",
      "name": "Products",
      "method": "GET",
      "url": "{{base_url}}/products",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "none"
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.test('$.data[?(@.name==\"Combination Pliers\")].id equals \"01M5MA4DENWHWN6YSKNZQW3G39\"', function() {\n  const matches = sp.jsonPath(json, '$.data[?(@.name==\"Combination Pliers\")].id');\n  sp.expect(matches.length).to.be.above(0);\n  sp.expect(matches[0]).to.equal(\"01M5MA4DENWHWN6YSKNZQW3G39\");\n});"
    },
    "d05b39f9-ed81-47d3-8359-ff45af7285ae": {
      "id": "d05b39f9-ed81-47d3-8359-ff45af7285ae",
      "name": "Login",
      "method": "POST",
      "url": "{{base_url}}/users/login",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "json",
        "json": "{\n  \"email\": \"customer2@practicesoftwaretesting.com\",\n  \"password\": \"{{vault:secret/data/login#password}}\"\n}"
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.variables.set(\"access_token\", String(json.access_token));",
      "hookType": "beforeAll"
    },
    "219fd207-a6ff-4d5e-9f04-aafb70407407": {
      "id": "219fd207-a6ff-4d5e-9f04-aafb70407407",
      "name": "Invoices",
      "method": "GET",
      "url": "{{base_url}}/invoices",
      "headers": [],
      "params": [],
      "auth": {
        "type": "bearer",
        "token": "{{access_token}}"
      },
      "body": {
        "mode": "none"
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.test('total exists', function() {\n  sp.expect(json.total).to.not.be.oneOf([null, undefined]);\n});"
    },
    "4d2552af-a223-4366-af55-636f08c7a8d1": {
      "id": "4d2552af-a223-4366-af55-636f08c7a8d1",
      "name": "GraphQL products",
      "method": "POST",
      "url": "https://api.practicesoftwaretesting.com/graphql",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "graphql",
        "graphql": {
          "query": "{ products { data { name price } } }",
          "variables": ""
        }
      }
    },
